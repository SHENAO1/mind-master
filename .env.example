# Mind-Master environment template
# Default workflow is local-first and does not upload source documents.

# Optional model configuration for IDE agents or local wrappers.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=

# Optional OCR configuration.
TESSERACT_CMD=
OCR_LANGUAGE=eng+chi_sim

# Optional image/model service keys, only used when a future script explicitly opts in.
IMAGE_API_KEY=
IMAGE_API_BASE_URL=

# Playwright defaults.
PLAYWRIGHT_BROWSER=chromium
SCREENSHOT_TIMEOUT_MS=30000

# Export defaults.
MIND_MASTER_EXPORT_SCALE=2
